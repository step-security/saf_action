{
  "name": "saf_action",
  "version": "1.10.1",
  "description": "GitHub Action for the [SAF CLI](https://github.com/mitre/saf)",
  "main": "index.js",
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node24 --outfile=dist/index.js --external:@mitre/saf --external:@oclif",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/saf_action.git"
  },
  "keywords": [
    "mitre-saf",
    "mitre",
    "SAF",
    "actions"
  ],
  "author": "step-security",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/step-security/saf_action/issues"
  },
  "homepage": "https://github.com/step-security/saf_action#readme",
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@mitre/saf": "^1.7.0",
    "axios": "^1.19.0",
    "shell-quote": "^1.8.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^4.0.16"
  }
}
